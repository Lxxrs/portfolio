# Hetzner SFTP/SSH Deployment Credentials
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# SSH/SFTP Connection (Required)
HETZNER_HOST=www111.your-server.de
HETZNER_USER=your_username
HETZNER_PORT=22

# Remote path (Optional - defaults to home directory)
# Leave empty or set to "." if already in correct directory
HETZNER_REMOTE_PATH=

# Authentication: Choose ONE method below

# Option 1: SSH Key (Recommended)
# Path to your private key file
HETZNER_SSH_KEY=~/.ssh/id_ed25519

# Option 2: Password (Not recommended - use SSH key instead)
# Requires sshpass to be installed (brew install sshpass)
# HETZNER_PASSWORD=
