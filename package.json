{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "lint": "vp lint .",
    "test": "vp test",
    "preview": "vp preview",
    "prepare": "vp config"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.7",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.19",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vite-plus": "^0.1.19",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.19"
  },
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.19",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.19"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@0.1.19",
      "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.19"
    },
    "packageExtensions": {
      "@vue/test-utils@*": {
        "dependencies": {
          "@vue/compiler-dom": "*",
          "@vue/server-renderer": "*",
          "vue": "*"
        }
      },
      "@tailwindcss/vite@*": {
        "peerDependenciesMeta": {
          "vite": {
            "optional": true
          }
        }
      },
      "@vitejs/plugin-vue@*": {
        "peerDependenciesMeta": {
          "vite": {
            "optional": true
          }
        }
      },
      "vite-plugin-pwa@*": {
        "peerDependenciesMeta": {
          "vite": {
            "optional": true
          }
        }
      }
    }
  }
}
