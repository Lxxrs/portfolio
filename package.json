{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "check": "vp check",
    "lint": "vp lint .",
    "test": "vp test",
    "preview": "vp preview",
    "prepare": "vp config"
  },
  "dependencies": {
    "@lucide/vue": "^1.17.0",
    "@tailwindcss/vite": "^4.3.0",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.1.24",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vite-plus": "^0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.24"
  },
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.24"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@^0.1.24",
      "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.24"
    },
    "packageExtensions": {
      "@vue/test-utils@*": {
        "dependencies": {
          "@vue/compiler-dom": "*",
          "@vue/server-renderer": "*",
          "vue": "*"
        }
      },
      "@tailwindcss/vite@*": {
        "peerDependenciesMeta": {
          "vite": {
            "optional": true
          }
        }
      },
      "@vitejs/plugin-vue@^1.3.0": {
        "peerDependenciesMeta": {
          "vite": {
            "optional": true
          }
        }
      },
      "vite-plugin-pwa@*": {
        "peerDependenciesMeta": {
          "vite": {
            "optional": true
          }
        }
      }
    }
  }
}
