---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import OperatorMask from "../components/OperatorMask.astro";
import { Font, getImage } from "astro:assets";
import { site } from "../data/site.ts";
import memojiSrc from "../assets/lars_memoji.webp";
import { themeBootSource, themeBootHash } from "../scripts/theme-boot.ts";

interface Props {
  title?: string;
}
const { title = `${site.name} | ${site.role}` } = Astro.props;

Astro.csp?.insertScriptHash({ hash: themeBootHash, kind: "element" });

const favicon = await getImage({
  src: memojiSrc,
  width: 32,
  height: 32,
  format: "png",
});
const appleTouchIcon = await getImage({
  src: memojiSrc,
  width: 180,
  height: 180,
  format: "png",
});
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <Font cssVariable="--font-jetbrains-mono" preload />
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta
      name="robots"
      content="noindex, nofollow, noarchive, nosnippet, noimageindex"
    />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0a0e1a" />
    <title>{title}</title>
    <link rel="icon" type="image/png" sizes="32x32" href={favicon.src} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon.src} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline set:html={themeBootSource} />
  </head>
  <body>
    <!--
         ┌──────────────────────────────────────────────┐
         │  you read source. respect.                   │
         │  no trackers in here — just HTML and CSS.    │
         │  larmart.de · built with astro · exit 0      │
         └──────────────────────────────────────────────┘
    -->
    <div class="spotlight" aria-hidden="true"></div>
    <a class="skip-link" href="#main">skip to content</a>
    <NavBar />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <OperatorMask />
    <script>
      import { initUI } from "../scripts/ui.ts";
      initUI();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: var(--z-skip);
    background: var(--accent);
    color: var(--ink);
    padding: 0.6rem 1rem;
    font-weight: 700;
    border-radius: var(--r-sm);
  }
  .skip-link:focus-visible {
    left: var(--gutter);
    top: 0.6rem;
  }
  main {
    position: relative;
    z-index: var(--z-content);
  }
</style>
