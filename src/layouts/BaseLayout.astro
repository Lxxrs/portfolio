---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import OperatorMask from "../components/OperatorMask.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
}
const { title = `${site.name} | ${site.role}` } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <!-- Privacy: never indexed, never previewed. No OG/Twitter/canonical/sitemap on purpose. -->
    <meta
      name="robots"
      content="noindex, nofollow, noarchive, nosnippet, noimageindex"
    />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0a0e1a" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/JetBrainsMono-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/JetBrainsMono-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Theme init before first paint (FOUC guard). If you edit this script,
         recompute its CSP hash — see astro.config.mjs. -->
    <script is:inline>
      (function () {
        var t = null;
        try {
          t = localStorage.getItem("theme");
        } catch (e) {}
        var light = t === "light";
        document.documentElement.classList.toggle("light", light);
        document.documentElement.classList.toggle("dark", !light);
      })();
    </script>
  </head>
  <body>
    <!--
         ┌──────────────────────────────────────────────┐
         │  you read source. respect.                   │
         │  no trackers in here — just HTML and CSS.    │
         │  larmart.de · built with astro · exit 0      │
         └──────────────────────────────────────────────┘
    -->
    <div class="spotlight" aria-hidden="true"></div>
    <a class="skip-link" href="#main">skip to content</a>
    <NavBar />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <OperatorMask />
    <script>
      import "../scripts/ui.ts";
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 300;
    background: var(--accent);
    color: var(--ink);
    padding: 0.6rem 1rem;
    font-weight: 700;
    border-radius: var(--r-sm);
  }
  .skip-link:focus-visible {
    left: var(--gutter);
    top: 0.6rem;
  }
  main {
    position: relative;
    z-index: 1;
  }
</style>
