---
import { statusChar, statusLabel } from "../data/skills.ts";
import { treeRows } from "../lib/skill-tree.ts";

const rows = treeRows();
---

<p class="lede">
  Things I reach for.
  <span class="legend" aria-hidden="true">
    — <b class="st-prod">■</b> production · <b class="st-familiar">◐</b>{" "}
    familiar · <b class="st-learning">○</b> learning
  </span>
</p>

<ul class="tree" aria-label="Skills, grouped">
  {rows.map((r) => (
    <li>
      {r.conn && (
        <span class="conn" aria-hidden="true">
          {r.conn}
        </span>
      )}
      {r.kind !== "leaf" ? (
        <>
          <span class="dir">{r.text}</span>
          {r.hint && <span class="hint"> — {r.hint}</span>}
        </>
      ) : (
        <>
          <span class={`st-${r.status}`} aria-hidden="true">
            {statusChar[r.status!]}
          </span>{" "}
          <span class="leaf">{r.text}</span>
          <span class="visually-hidden">({statusLabel[r.status!]})</span>
        </>
      )}
    </li>
  ))}
</ul>

<style>
  .lede {
    color: var(--text-muted);
    margin: 0 0 1.6rem;
    font-size: var(--t-sm);
  }
  .legend {
    color: var(--text-faint);
  }
  .legend b {
    font-weight: 400;
  }
  .tree {
    list-style: none;
    margin: 0;
    padding: 1.1rem 1.2rem;
    font-size: var(--t-sm);
    line-height: 1.95;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--ink-2);
    overflow-x: auto;
  }
  .tree li {
    white-space: nowrap;
  }
  :global(html.js) .tree li {
    opacity: 0;
    transform: translateX(-6px);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .tree li {
      opacity: 1;
      transform: none;
    }
  }
  :global(html.js) .tree.is-visible li {
    animation-name: boot-line;
    animation-duration: 0.16s;
    animation-timing-function: ease-out;
    animation-fill-mode: forwards;
  }
  .conn {
    color: var(--text-chrome);
    white-space: pre;
  }
  .dir {
    color: var(--text);
    font-weight: 500;
  }
  .hint {
    color: var(--text-faint);
  }
  .leaf {
    color: var(--text-muted);
  }
  .tree li:hover .leaf {
    color: var(--text);
  }
  :global(.st-prod) {
    color: var(--accent);
  }
  :global(.st-familiar) {
    color: var(--text-muted);
  }
  :global(.st-learning) {
    color: var(--warning);
  }
</style>
