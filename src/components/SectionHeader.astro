---
interface Props {
  num: string;
  command: string;
}
const { num, command } = Astro.props;
---

<header class="manifest">
  <span class="marker"
    ><span class="num">§ {num}</span><span class="p">$</span> {command}</span
  >
  <span class="rule" aria-hidden="true"><span class="fill"></span></span>
</header>

<style>
  .manifest {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
    font-size: var(--t-sm);
  }
  .marker {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  .num {
    color: var(--text-faint);
    font-weight: 400;
    margin-right: 0.55rem;
  }
  .p {
    color: var(--text-chrome);
    margin-right: 0.4rem;
  }
  .rule {
    flex: 1;
    height: 1px;
    background: var(--border);
    position: relative;
    overflow: hidden;
  }
  .fill {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform var(--dur-slow) var(--ease-out-quint);
  }
  :global(.manifest.is-visible) .fill {
    transform: scaleX(1);
  }
</style>
