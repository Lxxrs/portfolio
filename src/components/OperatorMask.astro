---
// Original "operator mask" — >_ prompt-glyph eyes, geometric grin.
// Easter egg overlay: shown by ui.ts (type "fsociety" or footer ¶ ×3).
const colors = ["#7aa2f7", "#ff5c8a", "#e8eef4"] as const;
const layer = ["l2", "l3", "l1"] as const;
---

<div class="egg-mask" id="egg-mask" role="dialog" aria-label="hello, friend" aria-modal="true">
  <div class="stage">
    {colors.map((c, i) => (
      <div class={`layer ${layer[i]}`} aria-hidden="true">
        <svg viewBox="0 0 120 140" xmlns="http://www.w3.org/2000/svg">
          <path d="M18 28 Q18 8 60 8 Q102 8 102 28 L102 84 Q102 116 60 132 Q18 116 18 84 Z" fill="none" stroke={c} stroke-width="4" />
          <path d="M26 44 Q38 34 50 42" fill="none" stroke={c} stroke-width="4" stroke-linecap="round" />
          <path d="M94 44 Q82 34 70 42" fill="none" stroke={c} stroke-width="4" stroke-linecap="round" />
          <text x="30" y="66" font-family="JetBrains Mono, monospace" font-size="24" font-weight="700" fill={c}>&gt;</text>
          <text x="72" y="66" font-family="JetBrains Mono, monospace" font-size="24" font-weight="700" fill={c}>&lt;</text>
          <path d="M34 92 L46 100 L54 90 L60 100 L66 90 L74 100 L86 92" fill="none" stroke={c} stroke-width="4" stroke-linejoin="round" stroke-linecap="round" />
        </svg>
      </div>
    ))}
  </div>
  <p class="cap">hello, friend.</p>
</div>

<style>
  .egg-mask { position: fixed; inset: 0; z-index: 200; background: #000; display: none;
    place-items: center; cursor: pointer; }
  .egg-mask:global(.is-on) { display: grid; animation: egg-fade 0.25s ease; }
  .stage { position: relative; width: min(38vw, 240px); aspect-ratio: 6 / 7; }
  .layer { position: absolute; inset: 0; }
  .layer svg { width: 100%; height: 100%; }
  .l1 { animation: egg-j1 0.9s steps(2) infinite; }
  .l2 { mix-blend-mode: screen; animation: egg-j2 0.7s steps(3) infinite; }
  .l3 { mix-blend-mode: screen; animation: egg-j3 1.1s steps(2) infinite; }
  .cap { position: absolute; left: 50%; bottom: 12vh; transform: translateX(-50%);
    color: #e8eef4; font-size: var(--t-sm); letter-spacing: 0.14em; }
  .cap::after { content: "▊"; color: var(--accent); animation: blink 1s step-end infinite; margin-left: 0.3rem; }
</style>
